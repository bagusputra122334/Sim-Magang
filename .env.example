APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# MAIL CONFIGURATION — SIM-MAGANG Dinas Komunikasi & Informatika
# ============================================================
# 8 Environment Variable yang digunakan Laravel Mail:
# ┌────────────────────────────────────────────────────────────────────┐
# │ MAIL_MAILER       Driver pengiriman email (smtp, log, array, ses, │
# │                   postmark, sendmail, failover).                  │
# │                   - Dev (cek tanpa kirim nyata): MAIL_MAILER=log │
# │                   - Mailtrap Sandbox Dev: MAIL_MAILER=smtp        │
# │                   - Production (Gmail/SMTP Office): MAIL_MAILER=smtp│
# ├────────────────────────────────────────────────────────────────────┤
# │ MAIL_SCHEME       Enkripsi TLS/STARTTLS (null / tls / ssl).       │
# │                   Kosongkan (null) untuk port 2525 Mailtrap.      │
# ├────────────────────────────────────────────────────────────────────┤
# │ MAIL_HOST         Alamat SMTP Server.                              │
# │     Mailtrap Free / Paid: sandbox.smtp.mailtrap.io                │
# │     Gmail SMTP:                 smtp.gmail.com                    │
# │     Zoho Mail SMTP:             smtp.zoho.com                     │
# │     Microsoft365 SMTP:          smtp.office365.com                │
# ├────────────────────────────────────────────────────────────────────┤
# │ MAIL_PORT         Port SMTP Server:                                │
# │     Mailtrap 2525 / Gmail 587 / Office365 587 / Zoho 465 (SSL)    │
# ├────────────────────────────────────────────────────────────────────┤
# │ MAIL_USERNAME     Username akun SMTP / Mailtrap Username (lihat   │
# │                   Mailtrap → Inbox → Settings → SMTP Settings).   │
# ├────────────────────────────────────────────────────────────────────┤
# │ MAIL_PASSWORD     Password akun SMTP / Mailtrap Password          │
# │                   (JANGAN commit password ini ke GIT!)            │
# ├────────────────────────────────────────────────────────────────────┤
# │ MAIL_ENCRYPTION   Metode enkripsi koneksi SMTP:                    │
# │                    - Mailtrap Port 2525: kosongkan "null"         │
# │                    - Gmail/Office365 Port 587: gunakan "tls"      │
# │                    - Zoho / Office Port 465: gunakan "ssl"        │
# ├────────────────────────────────────────────────────────────────────┤
# │ MAIL_FROM_ADDRESS Alamat email "PENGIRIM" yang muncul di header   │
# │                   email. PRODUCTION WAJIB VERIFIKASI DKIM SPF DMARC│
# │                   Contoh: simagang@diskominfo-tuban.go.id         │
# ├────────────────────────────────────────────────────────────────────┤
# │ MAIL_FROM_NAME    Nama pengirim (muncul di inbox penerima).       │
# │                   ${APP_NAME} otomatis ambil dari APP_NAME atas   │
# │                   atau override: SIM-MAGANG Diskominfo Tuban      │
# └────────────────────────────────────────────────────────────────────┘
#
# MODE DEFAULT DEVELOPMENT: MAIL_MAILER=log
#   → Semua email TIDAK KIRIM NYATA, tapi TERCETAK ke:
#     storage/logs/laravel.log + storage/logs/laravel-mail.log
#   → Cocok untuk testing Sprint 19 sebelum install Mailtrap / Production.
MAIL_MAILER=log
MAIL_SCHEME=null

# ============================================================
# CONTOH KONFIGURASI MAILTRAP (SANDBOX DEVELOPMENT — UNTUK TESTING)
# Daftar Mailtrap Free: https://mailtrap.io/register/signup-free
# Setelah login: Email Testing → Inboxes → Pilih Inbox → SMTP Settings
# Salin Username + Password (BUKAN password akun Mailtrap, tapi INBOX PASS)
# Setelah itu COPY 6 line di bawah ini ke .env LOKAL Anda, uncomment:
# ============================================================
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=xxxxxxxxxxxxxxxx   ← ganti dengan Mailtrap Inbox Username Anda
# MAIL_PASSWORD=yyyyyyyyyyyyyyyy   ← ganti dengan Mailtrap Inbox Password Anda
# MAIL_ENCRYPTION=null

# ============================================================
# CONTOH PRODUCTION (contoh SMTP resmi Dinas jika sudah ada)
# ============================================================
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.diskominfo-tuban.go.id
# MAIL_PORT=587
# MAIL_USERNAME=simagang@diskominfo-tuban.go.id
# MAIL_PASSWORD="KataSandiEmailRahasia_D1s1n1_JANGAN_DICOMMIT_GIT!"
# MAIL_ENCRYPTION=tls

MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="simagang@diskominfo-tuban.go.id"
MAIL_FROM_NAME="SIM-MAGANG — Diskominfo Kabupaten Tuban"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
